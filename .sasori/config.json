{
  "base": "main",
  "checks": [
    "npm run lint",
    "npm run typecheck",
    "CI=1 npm test",
    "npm run test:e2e",
    "npm run build"
  ],
  "workflows": {
    "CI": "ci.yml",
    "QA": "sasori-qa.yml",
    "Security": "sasori-security.yml"
  },
  "ci": "sessions",
  "hotFiles": [
    "package.json",
    "package-lock.json",
    "src/app/layout.tsx",
    "src/app/globals.css",
    "src/app/page.tsx",
    ".github/workflows/collect.yml",
    "src/lib/bulletin.ts"
  ],
  "mergeMethod": "squash",
  "trainMode": "fast",
  "perRepoLanes": 5,
  "actionsKeep": [
    "collect.yml",
    "pages.yml"
  ]
}
